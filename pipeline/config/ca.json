{
  "extends": "_north-america",
  "_comment": "All of Canada (data/regions/ca.geojson, admin level 2). Generic North American rules come from _north-america.json; only what differs from the United States is here.",
  "stat_name": "Canada",
  "stat_local": "Canada",
  "stat_auto": {
    "country": "CA"
  },
  "+type_overrides": [
    {
      "match": {
        "name_re": "^VIA Rail Corridor"
      },
      "type": "intercity"
    }
  ],
  "+track_type_overrides": [
    {
      "match": {
        "name_re": "^GO Transit.*Weston Subdivision"
      },
      "type": "regional"
    }
  ]
}
