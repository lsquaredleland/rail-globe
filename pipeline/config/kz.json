{
  "extends": "_default",
  "_comment": "Kazakhstan. KTZ long-distance trains carry no service=* tag and defaulted to Regional (docs/qa/east-europe.md).",
  "+type_overrides": [
    {
      "match": {
        "name_re": "^\\d{1,3}[A-Za-zА-Яа-я]?(/\\d{1,3}[A-Za-zА-Яа-я]?)? +\\S.*(<=>|-)"
      },
      "type": "intercity"
    },
    {
      "match": {
        "name_re": "^(Astana|Астана)\\s*(<=>|-|–)|(<=>|-|–)\\s*(Astana|Астана)$"
      },
      "type": "intercity"
    }
  ]
}
