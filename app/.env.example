# Public URL of the R2 bucket that holds the pipeline output (tiles and side files), with a trailing slash. Leave unset to use app/public/data.
# Set it in the Vercel project's environment variables (Production and Preview). The bucket needs CORS (GET, HEAD, Range header allowed).
# The same origin must be in connect-src in vercel.json: scripts/check-deploy.mjs fails the Vercel build otherwise.
# r2.dev URLs are refused unless ALLOW_R2_DEV=1 (dev only).
VITE_DATA_BASE=https://network-data.lsquared.cc/
