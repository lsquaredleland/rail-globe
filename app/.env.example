# Public URL of the R2 bucket that holds the pipeline output (tiles and side files). Leave unset to use app/public/data.
# Set it in the Vercel project's environment variables. The bucket needs CORS (GET, HEAD, Range header allowed).
VITE_DATA_BASE=https://pub-xxxxxxxx.r2.dev/
# Must be the R2 custom domain (https, not r2.dev) and must also appear in connect-src in vercel.json:
# scripts/check-deploy.mjs fails the Vercel build otherwise.
